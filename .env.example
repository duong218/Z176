# .env.example — Bản mẫu biến môi trường (KHÔNG chứa giá trị thật)
# Module Thi Chuyên Môn Nội Bộ — Z176
#
# Copy thành `.env` ở root và/hoặc `server/.env` (server đọc từ thư mục server khi chạy).
# 🔒 Không commit `.env` — xem .gitignore
# 🔒 Không dán giá trị thật vào AI tool — xem AGENT_RULES.md mục 1

# ── App ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ───────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/exam-system-dev

# ── Auth (JWT + bcrypt) — dev: dùng chuỗi giả bên dưới; production: đổi toàn bộ ──
JWT_SECRET=dev-jwt-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── CORS (SECURITY_BASELINE.md mục 6) ──────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Session / phiên thi ────────────────────────────────────────
EXAM_SESSION_SECRET=

# ── Rate limiting ──────────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
SUBMIT_RATE_LIMIT_MAX=10
SUBMIT_RATE_LIMIT_WINDOW_MINUTES=1

# ── Upload (MVP: disk local — SKILLS.md / prompt) ──────────────
UPLOAD_DIR=./uploads

# ── Cloudinary (ảnh câu hỏi — DEMO-ONLY, xem SECURITY_BASELINE.md mục 4) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Drive backup (DEMO-ONLY — export JSON + nén, không mongodump) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# ── Admin seed (mock demo — KHÔNG dùng cho Z176 thật) ───────────
# Username đăng nhập = giá trị ADMIN_SEED_EMAIL (có thể không phải email).
SEED_ON_START=true
ADMIN_SEED_EMAIL=admin.demo
ADMIN_SEED_PASSWORD=DemoAdmin@12345
ADMIN_SEED_MUST_CHANGE_PASSWORD=false

# ── Client URL ─────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
