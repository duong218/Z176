# .env.example — Bản mẫu biến môi trường
# Module Thi Chuyên Môn Nội Bộ — Z176
#
# 🔒 KHÔNG BAO GIỜ commit file .env thật lên git (chỉ commit .env.example này).
# 🔒 KHÔNG đưa giá trị thật của các biến bên dưới vào bất kỳ AI tool nào — xem AGENT_RULES.md mục 1.
# Copy file này thành .env rồi tự điền giá trị thật (local/dev) — không dùng giá trị mẫu cho production.

# ── App chung ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB — xem SKILLS.md mục 1, đổi nếu chốt PostgreSQL sau khảo sát) ──
MONGO_URI=mongodb://localhost:27017/exam-system-dev
# 🔸 Nếu đổi sang PostgreSQL (chờ khảo sát #26): DATABASE_URL=postgresql://user:pass@localhost:5432/exam_system

# ── Auth (JWT + bcrypt — SKILLS.md mục 1, SECURITY_BASELINE.md mục 1-2) ─────
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_LONG_STRING_DO_NOT_COMMIT
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_LONG_STRING_DO_NOT_COMMIT
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── Session thi (SECURITY_BASELINE.md mục 2) ────────────────────
EXAM_SESSION_SECRET=REPLACE_WITH_RANDOM_LONG_STRING_DO_NOT_COMMIT
# Dùng crypto.randomInt() để trộn đề/đáp án — KHÔNG dùng Math.random() (SKILLS.md mục 4.5)

# ── CORS (SECURITY_BASELINE.md mục 6) ───────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Rate limiting (SECURITY_BASELINE.md mục 5-6) ────────────────
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
SUBMIT_RATE_LIMIT_MAX=10
SUBMIT_RATE_LIMIT_WINDOW_MINUTES=1

# ── Third-party / Cloud services ─────────────────────────────
# 🔒 CHƯA XÁC NHẬN với Ban CNTT Z176 — KHÔNG bật các biến dưới đây cho production
# (AGENT_RULES.md mục 2.1, SECURITY_BASELINE.md mục 4)
# SENTRY_DSN=
# ANALYTICS_KEY=

# ── Deploy demo (nếu chưa deploy on-premise — LIBRARY.md mục 8) ──
# 🔸 Chỉ dùng cho bản demo, KHÔNG BAO GIỜ trỏ vào MONGO_URI thật khi deploy demo public
# RENDER_EXTERNAL_URL=
# VERCEL_URL=

# ── Seed / Mock data (mock-data/ — AGENT_RULES.md mục 1) ────────
SEED_ON_START=false
SEED_SOURCE=mock-data
