# Server — copy thành `server/.env` (hoặc dùng chung file `.env` ở root repo)
# 🔒 Chỉ dùng tài khoản/mật khẩu DEMO — không dữ liệu thật Z176 (AGENT_RULES.md)

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/exam-system-dev

JWT_SECRET=dev-jwt-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

CORS_ORIGIN=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
CLIENT_URL=http://localhost:5173

# Tự seed role + admin khi chạy `npm run dev` / `npm start` (development mặc định bật)
SEED_ON_START=true

# Tài khoản admin demo — username đăng nhập = ADMIN_SEED_EMAIL (mock, không phải nhân viên Z176)
ADMIN_SEED_EMAIL=admin
ADMIN_SEED_PASSWORD=123
# false = vào app ngay trên máy dev; production/Z176: đặt true
ADMIN_SEED_MUST_CHANGE_PASSWORD=false
